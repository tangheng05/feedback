# /etc/systemd/system/feedback.service
#
# Install:
#   sudo cp deploy/feedback.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now feedback
#
# Logs:    journalctl -u feedback -f
# Restart: sudo systemctl restart feedback

[Unit]
Description=Shop feedback server
After=network.target

[Service]
Type=simple
User=feedback
Group=feedback
WorkingDirectory=/opt/feedback
EnvironmentFile=/opt/feedback/.env
ExecStart=/usr/bin/node src/server.js

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening: the app only writes to data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/feedback/data

[Install]
WantedBy=multi-user.target
