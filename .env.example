# ---- Public URL -------------------------------------------------------------
# No trailing slash. This is what gets baked into every printed QR code,
# so changing it later invalidates every poster already on a wall.
PUBLIC_BASE_URL=https://feedback.yourshop.com
PORT=3000

# Interface to bind. Leave as 127.0.0.1 when nginx runs on this same machine:
# it is what guarantees the proxy is in the path and nobody can reach the app
# directly. Set to 0.0.0.0 only if your reverse proxy is on ANOTHER machine,
# and firewall this port to that machine's IP when you do.
BIND_HOST=127.0.0.1

# How many proxies sit in front of this app. It decides which entry of
# X-Forwarded-For is treated as the customer, counted from the right.
#
#   0  nothing in front         ignore the header, use the socket address
#   1  nginx or Nginx Proxy Manager alone
#   2  Cloudflare (orange cloud) in front of nginx / NPM
#
# Defaults to 1 when BIND_HOST is loopback, 0 otherwise. Both mistakes hurt:
# too high and a forged header becomes the identity, too low and every
# customer collapses onto the proxy's address and the tenth submission of the
# hour locks out the whole shop.
# TRUST_PROXY=1

# ---- Telegram ---------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The forum supergroup ID. Always negative, usually starts -100.
# See deploy/DEPLOY.md step 4 for how to find it.
TELEGRAM_GROUP_ID=-1001234567890

# Random secret used as the X-Telegram-Bot-Api-Secret-Token header. The webhook
# URL path is derived from it by hashing, never equal to it — nginx logs the
# path on every request, so the two must not be the same value.
# Generate with:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=replace_me_with_48_random_hex_chars

# ---- Branding ---------------------------------------------------------------
# All optional. Anything left blank is dropped from the layout rather than
# leaving a gap, so you can set as much or as little of this as you like.

# Shown above the shop name on the poster, and in the form header.
BRAND_NAME=

# Path to your logo, relative to the project root. It appears on the poster,
# in the form header, and in the CENTRE OF EVERY QR CODE.
#
# Must be a PNG: the same file is composited into the QR as pixels, and an SVG
# would need a rasteriser to get there. Transparency is fine. This must be the
# DARK artwork - it lands on white paper and on the white plate in the middle
# of the code.
#
# Avoid spaces in the filename; they have to be escaped in every command that
# touches the path afterwards.
#   scp "My Logo black.png" root@server:/opt/feedback/public/brand/logo.png
BRAND_LOGO=

# Optional second file, used ONLY by the form when the customer's phone is in
# dark mode. This is the light/white artwork. PNG or SVG.
#
# The poster and the QR never switch: both always use BRAND_LOGO, because both
# sit on white. A pale logo composited into the code would leave a blank hole
# in the middle of it.
BRAND_LOGO_DARK=

# Poster colours.
#   COLOR      the outer field behind the code
#   HIGHLIGHT  the inner block
#   ACCENT     the circles
# Defaults are a deep indigo with a lime block and periwinkle circles. For a
# plain black-and-white poster: COLOR=#111111 HIGHLIGHT=#ffffff ACCENT=#f2f2f2
BRAND_COLOR=#312E81
BRAND_HIGHLIGHT=#D9F04B
BRAND_ACCENT=#C7D2FE

# Optional contact lines under the QR on the poster. Omitted entirely if blank.
BRAND_PHONE=
BRAND_EMAIL=

# ---- Storage ----------------------------------------------------------------
DB_PATH=./data/feedback.db

# Salt for the daily IP hash used by rate limiting. Generate with:
# openssl rand -hex 32
IP_HASH_SALT=replace_me_with_random_hex

# ---- Rate limiting ----------------------------------------------------------
# Per IP *per location*. Generous on purpose: Cambodian mobile networks use
# CGNAT and mall wifi is one NAT, so many genuine customers share one address.
RATE_PER_IP_PER_HOUR=10

# Past this, submissions are still stored and the customer still gets a real
# reference code — only the Telegram push is suppressed, so a flood cannot bury
# genuine complaints. The topic gets one warning per hour.
RATE_PER_LOCATION_PER_HOUR=60

# ---- Optional: Cloudflare Turnstile ----------------------------------------
# Leave disabled until you actually see spam. Enabling it adds a third-party
# script to the customer form.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
