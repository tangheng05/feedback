# ---- Server -----------------------------------------------------------------
# Baked into every printed QR. No trailing slash; https except for local testing.
PUBLIC_BASE_URL=https://feedback.yourshop.com
PORT=3000

# Keep 127.0.0.1 when nginx is on this machine. Use 0.0.0.0 only if the proxy
# is elsewhere, and firewall the port to it.
BIND_HOST=127.0.0.1

# Proxies in front of the app: 0 none, 1 nginx/NPM, 2 Cloudflare + nginx/NPM.
# Defaults to 1 on loopback, else 0.
# TRUST_PROXY=1

# ---- Telegram ---------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Forum supergroup id, starts with -100 (deploy/DEPLOY.md step 4)
TELEGRAM_GROUP_ID=-1001234567890

# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=replace_me_with_48_random_hex_chars

# ---- Branding (all optional) ------------------------------------------------
BRAND_NAME=

# PNG, dark artwork, path relative to the project root. Also used in the QR centre.
BRAND_LOGO=

# Light artwork for the form in dark mode only. PNG or SVG.
BRAND_LOGO_DARK=

# Poster colours: outer field, inner block, circles
BRAND_COLOR=#312E81
BRAND_HIGHLIGHT=#D9F04B
BRAND_ACCENT=#C7D2FE

# Contact lines under the QR on the poster
BRAND_PHONE=
BRAND_EMAIL=

# ---- Storage ----------------------------------------------------------------
DB_PATH=./data/feedback.db

# openssl rand -hex 32
IP_HASH_SALT=replace_me_with_random_hex

# ---- Rate limiting ----------------------------------------------------------
# Per IP per location
RATE_PER_IP_PER_HOUR=10

# Past this, submissions are stored but not pushed to Telegram
RATE_PER_LOCATION_PER_HOUR=60

# ---- Cloudflare Turnstile (optional) ----------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
